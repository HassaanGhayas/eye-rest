{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "EyeRest",
  "version": "0.1.0",
  "identifier": "com.eyerest.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "EyeRest Break",
        "url": "overlay/index.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "shadow": false
      },
      {
        "label": "toast",
        "title": "EyeRest Notification",
        "url": "toast/index.html",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 360,
        "height": 76,
        "resizable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "EyeRest Preferences",
        "url": "settings/index.html",
        "visible": false,
        "decorations": true,
        "width": 480,
        "height": 620,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
